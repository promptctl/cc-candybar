{
  // The load gate's full config: a maintainer's live config, the bundled
  // default with a theme picker and lit's checkout-relative ticket segment.
  // Everything else not declared here stays the bundled default.

  // Theme picker: one action + one {{ menu }} — the loader synthesizes the
  // open/closed state, the page cursor, and the click gates. The trigger's
  // text is authored here, one display per state (closed, open); the runtime
  // appends no glyph of its own.
  actions: {
    applyTheme: { set: "theme", from: "themes" },
  },

  segments: {
    themeControl: {
      template: '🎨 {{ .theme.effective }} {{ menu "applyTheme" "▸" "▾" }}',
      bg: "surface",
      fg: "foreground",
    },
  },

  root: {
    v: [
      { h: ["directory", "gitaculous", "toolbar"] },
      { h: ["model", "context", "cacheTimer", "block", "weekly", "themeControl", "plugins.lit.ticket"] },
      // Every built-in the bundled default draws from the session's transcript
      // and hook data, so the gate prices every lane the daemon gathers.
      { h: ["metrics", "activity", "tokenSparkline", "autocompact"] },
    ],
  },
  themeDefaults: {
    "tokyo-night": {
      shade: "middle",
      variation: "alt",
      style: "none",
    },
  },
}
