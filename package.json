{
  "name": "@promptctl/cc-candybar",
  "version": "0.2.3",
  "description": "Powerline statusline for Claude Code — fork of @owloops/claude-powerline evolved into CCCandybar with CLI override flags (--layout, --set, --show, --display, --segment) so the entire config can live in settings.json without a separate config file.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "bin": {
    "cc-candybar": "./bin/cc-candybar"
  },
  "scripts": {
    "build": "tsdown",
    "build:rust": "cd rust-client && cargo build --release",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "tsx src/demo/app.ts",
    "benchmark:timing": "scripts/benchmark_timing.sh",
    "check:protocol": "node scripts/check-protocol.mjs",
    "prepack": "node scripts/write-bin-placeholder.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run check:protocol && npm run build"
  },
  "keywords": [
    "claude",
    "powerline",
    "statusline",
    "typescript",
    "claude-code"
  ],
  "author": "Brandon Fryslie",
  "license": "MIT",
  "homepage": "https://github.com/promptctl/cc-candybar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptctl/cc-candybar.git"
  },
  "bugs": {
    "url": "https://github.com/promptctl/cc-candybar/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "plugin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.1",
    "tsdown": "^0.21.4",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@promptctl/go-template-js": "file:../go-template-js",
    "mobx": "^6.15.0",
    "rich-js": "file:../rich-js"
  },
  "optionalDependencies": {
    "@promptctl/cc-candybar-darwin-arm64": "0.0.0-PLACEHOLDER",
    "@promptctl/cc-candybar-darwin-x64": "0.0.0-PLACEHOLDER",
    "@promptctl/cc-candybar-linux-x64": "0.0.0-PLACEHOLDER",
    "@promptctl/cc-candybar-linux-arm64": "0.0.0-PLACEHOLDER"
  }
}
