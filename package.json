{
  "name": "@promptctl/cc-candybar",
  "version": "1.214.0",
  "description": "Statusline renderer for Claude Code — a JSON5-configurable DSL with daemon-cached data sources, byte-clean palette-aware composition, and OSC8 click verbs.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "bin": {
    "cc-candybar": "./bin/cc-candybar"
  },
  "scripts": {
    "build": "tsdown",
    "build:rust": "cd rust-client && cargo build --release",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.mjs",
    "lint": "eslint src/ && eslint -c eslint.tests.config.mjs test/",
    "lint:fix": "eslint src/ --fix",
    "test": "pnpm test:unit && pnpm test:worker && pnpm test:process",
    "test:unit": "jest --config jest.unit.config.js",
    "test:worker": "jest --config jest.worker.config.js",
    "test:process": "jest --config jest.process.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests",
    "test:report": "node scripts/test-report.mjs",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "jest --config jest.unit.config.js --coverage",
    "audit:colour": "jest --config audits/jest.config.js",
    "demo": "tsx src/demo/dsl.ts",
    "gallery": "node --require ./scripts/version-stamp.cjs --import tsx src/demo/gallery.ts",
    "bar": "node --require ./scripts/version-stamp.cjs --import tsx scripts/drive-bar.ts",
    "bar:web": "node --require ./scripts/version-stamp.cjs --import tsx scripts/bar-web.ts",
    "site:build": "node site/build.mjs",
    "site:dev": "node site/build.mjs --serve",
    "bench": "node --require ./scripts/version-stamp.cjs --import tsx scripts/bench/index.ts",
    "check:protocol": "node scripts/check-protocol.mjs",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run check:protocol && npm run check:schema && npm run build"
  },
  "keywords": [
    "claude",
    "powerline",
    "statusline",
    "typescript",
    "claude-code"
  ],
  "author": "Brandon Fryslie",
  "license": "MIT",
  "homepage": "https://github.com/promptctl/cc-candybar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptctl/cc-candybar.git"
  },
  "bugs": {
    "url": "https://github.com/promptctl/cc-candybar/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "bin",
    "plugin",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@pkgjs/parseargs": "0.11.0",
    "@promptctl/go-template-js": "^0.10.0",
    "@promptctl/rich-js": "^0.27.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "ajv": "^8.20.0",
    "buffer": "6.0.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.28.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "events": "3.3.0",
    "jest": "^30.0.5",
    "jest-environment-node": "^30.0.5",
    "json5": "^2.2.3",
    "memfs": "4.80.0",
    "mobx": "^7.0.6",
    "path-browserify": "1.0.1",
    "prettier": "^3.6.2",
    "readable-stream": "4.7.0",
    "semantic-release": "^25.0.2",
    "smol-toml": "^1.9.1",
    "string_decoder": "1.3.0",
    "ts-jest": "^29.4.1",
    "tsdown": "^0.21.4",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
