{
  "theme": "monokai",
  "style": "muted",
  "display": {
    "padding": 1,
    "style": "capsule",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": true,
            "style": "fish"
          },
          "model": {
            "enabled": true
          },
          "session": {
            "enabled": true,
            "type": "both",
            "costSource": "calculated"
          },
          "today": {
            "enabled": true,
            "type": "both"
          }
        }
      },
      {
        "segments": {
          "block": {
            "enabled": true,
            "type": "weighted",
            "burnType": "tokens"
          },
          "version": {
            "enabled": true
          },
          "metrics": {
            "enabled": true,
            "showResponseTime": true,
            "showLastResponseTime": true,
            "showDuration": true,
            "showMessageCount": true,
            "showLinesAdded": true,
            "showLinesRemoved": true
          },
          "context": {
            "enabled": true,
            "showPercentageOnly": false,
            "displayStyle": "text",
            "autocompactBuffer": 33000
          },
          "tmux": {
            "enabled": false
          }
        }
      },
      {
        "segments": {
          "git": {
            "enabled": true,
            "showWorkingTree": true,
            "showUpstream": true,
            "showTimeSinceCommit": true
          }
        }
      }
    ]
  },
  "budget": {
    "session": {
      "warningThreshold": 80
    },
    "today": {
      "amount": 5.0,
      "warningThreshold": 80
    },
    "block": {
      "amount": 20000000,
      "type": "tokens",
      "warningThreshold": 80
    }
  },
  "panel": {
    "items": [
      { "text": "🎨 ${theme}", "verb": "theme-cycle", "expr": "session.id" },
      { "text": "🖌 ${style}", "verb": "style-cycle", "expr": "session.id" }
    ]
  },
  "modelContextLimits": {
    "sonnet": 200000
  }
}
