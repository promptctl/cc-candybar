{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "force",
    "isolatedModules": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "types": ["node"]
  },
  "include": [
    "src/**/*", "site/**/*", "scripts/**/*", "proto-looks/**/*",
    ".github/scripts/**/*", "tsdown.config.ts", "candybar-lite.mjs"
  ],
  "exclude": [
    "node_modules", "dist",
    "scripts/bar-web/**/*.js", "scripts/bar-web/**/*.jsx",
    "scripts/bar-web/**/*.mjs", "scripts/bar-web/**/*.cjs",
    "scripts/bar-web/**/*.d.ts", "scripts/bar-web/**/*.d.mts", "scripts/bar-web/**/*.d.cts"
  ]
}
