;; The sandbox a captured statusline runs in. No network. Reads are denied under every directory
;; that holds this machine's state (homes, mounted volumes, the shared temp trees where tools such
;; as Claude Code keep task output, and the per-user temp directories), then allowed back for the
;; run copy, the project source and the bun install. The per-user cache directories beside the
;; temp ones stay readable: the system libraries consult them on every launch. The temp directory
;; comes in as the UTMP parameter (its real path, under /private) because a regex rule over
;; /var/folders costs a second per process launch while a subpath rule costs nothing. Ancestors of
;; the run copy allow metadata reads only, so a realpath walk succeeds without exposing their
;; contents. Writes are denied everywhere but the run copy and the null device.
(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath "/Users"))
(deny file-read* (subpath "/Volumes"))
(deny file-read* (subpath "/private/tmp"))
(deny file-read* (subpath "/tmp"))
(deny file-read* (subpath (param "UTMP")))
(allow file-read-metadata (literal "/private/tmp") (literal "/tmp") (literal "/private/tmp/ccland") (literal "/private/tmp/ccland/runs"))
(deny file-write*)
(allow file-write* (subpath (param "RUN")))
(allow file-write* (literal "/dev/null") (literal "/dev/tty") (regex #"^/dev/ttys"))
(allow file-read* (subpath (param "RUN")))
(allow file-read* (subpath (param "SRC")))
(allow file-read* (subpath "/Users/bmf/.bun/bin"))
(allow file-read* (subpath "/Users/bmf/.bun/install/global"))
(allow file-read* (subpath "/Users/bmf/.cache/bun"))
