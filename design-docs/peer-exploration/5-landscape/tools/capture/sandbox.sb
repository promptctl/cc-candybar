;; The sandbox a captured statusline runs in. No network. Reads are denied under every directory
;; that holds this machine's state (homes, mounted volumes, the shared temp trees where tools such
;; as Claude Code keep task output, and the per-user temp directories), then allowed back for the
;; run copy, the project source and the bun install. The per-user cache directories beside the
;; temp ones stay readable: the system libraries consult them on every launch. The temp directory
;; comes in as the UTMP parameter (its real path, under /private) because a regex rule over
;; /var/folders costs a second per process launch while a subpath rule costs nothing. Ancestors of
;; the run copy allow metadata reads only, so a realpath walk succeeds without exposing their
;; contents. Writes are denied everywhere but the run copy and the null device: the runner reads
;; the bar from pipes, so no terminal device is writable, and a write to another pty cannot reach
;; the developer's open terminals.
;;
;; LaunchServices opens are denied, so a script cannot start an app.
;;
;; This profile does not contain inter-process requests. A process under it still asks the
;; user's GUI session to act for it: osascript drives Finder or Terminal here even under a
;; deny-default profile with every mach lookup refused, and whatever that session runs, runs
;; unsandboxed with the user's network and files. A rule that seems to close this does not, so
;; none is written here. Containing the runs means taking the session away from them: a separate
;; user with no GUI login, or a VM.
(version 1)
(allow default)
(deny network*)
(deny lsopen)
;; The keychain: the login keychain's file is already under the /Users read deny; the daemons that
;; serve keychain items over IPC are refused too, so a script cannot ask for a stored token.
(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.keychain-circle-notification")
  (global-name "com.apple.secd")
  (global-name "com.apple.security.cloudkeychainproxy3")
  (global-name "com.apple.security.keychainsyncingoveridsproxy"))
(deny file-read* (subpath "/Users"))
(deny file-read* (subpath "/Volumes"))
(deny file-read* (subpath "/private/tmp"))
(deny file-read* (subpath "/tmp"))
(deny file-read* (subpath (param "UTMP")))
(allow file-read-metadata (literal "/private/tmp") (literal "/tmp") (literal (param "RUNS_PARENT")) (literal (param "RUNS")))
(deny file-write*)
(allow file-write* (subpath (param "RUN")))
(allow file-write* (literal "/dev/null"))
(allow file-read* (subpath (param "RUN")))
(allow file-read* (subpath (param "SRC")))
;; the bun install and its cache, by their real paths: the runner passes them in, so the profile
;; holds no machine's home directory
(allow file-read* (subpath (string-append (param "BUN") "/bin")))
(allow file-read* (subpath (string-append (param "BUN") "/install/global")))
(allow file-read* (subpath (param "BUN_CACHE")))
